# DocConnect Environment Variables Template
# Safe for git committing - no real secrets
# Copy this file to .env in your root, backend, and frontend directories

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docconnect
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false

# Optional PostgreSQL Connection String URI (overrides individual variables if provided)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/docconnect

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Optional Google OAuth & Gmail Notifications
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Frontend Configuration (leave empty for relative reverse proxy in production/Nginx)
VITE_API_URL=
