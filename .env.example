# DocConnect Environment Variables Template
# Copy this file to .env in your root, backend, and frontend directories

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docconnect
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false

# Optional PostgreSQL Connection String URI (overrides individual variables if provided)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/docconnect

# Frontend Configuration
VITE_API_URL=http://localhost:5000
